# DARK MODE
#
background = #0a0a0a
foreground = #ffffff

# LIGHT MODE
#
#background = #ffffff
#foreground = #0a0a0a

cursor-color = #ffffff
cursor-text = #000000
selection-background = #313131
selection-foreground = #ffffff



