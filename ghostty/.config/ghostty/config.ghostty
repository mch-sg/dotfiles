theme = Ultra Dark 
## 12-bit Rainbow
## Adventure, Alabaster, Flexoki Dark , iTerm2 Tango Light
font-family = "JetBrains Mono"
# Hack Regular, JetBrains Mono, Hack Nerd Font
font-size = 15
## ^^ 14
adjust-cell-height = 10%
font-style = "Bold"

# Match the background to pure white or parchment
#background = #ffffff
#foreground = #1e1e1e

##
## KEYBINDS
##
keybind = cmd+backspace=text:\x15
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = cmd+up=text:\x1b[28~
keybind = cmd+down=text:\x1b[29~


##
## COPIED
##

window-save-state = always
gtk-titlebar = false

# --- Window & Canvas (Warp's breathing room) ---
window-theme = ghostty
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend

# macOS Titlebar (matches window background seamlessly)
macos-titlebar-style = tabs 
# ^^ hidden, tabs
window-decoration = true 
# ^^ none
macos-option-as-alt = left

# Subtle modern background blur
background-opacity = 1
background-blur = 40

# --- Cursor (Warp accent bar/block) ---
cursor-style = block
cursor-style-blink = false
#cursor-color = #00e5ff
#cursor-text = #0d0f12
shell-integration-features = no-cursor

# --- Mouse & Scrolling ---
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# --- Colors: Warp Dark Signature Palette ---
#background = #000000
#foreground = #e6edf3
#selection-background = #2b3245
#selection-foreground = #ffffff



##
## THEME
##

